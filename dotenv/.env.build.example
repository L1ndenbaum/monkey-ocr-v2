HTTP_PROXY=http://host.docker.internal:9090
HTTPS_PROXY=http://host.docker.internal:9090
NO_PROXY=localhost,127.0.0.1,api,vllm,web
# Compose uses the names below for Dockerfile build args so the host Docker
# client can retain its own HTTP_PROXY/HTTPS_PROXY without overriding them.
MONKEYOCR_BUILD_PROXY=http://host.docker.internal:9090
MONKEYOCR_BUILD_NO_PROXY=localhost,127.0.0.1,api,vllm,web
UV_INDEX_URL=https://pypi.org/simple
