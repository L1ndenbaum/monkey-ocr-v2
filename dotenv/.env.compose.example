COMPOSE_PROJECT_NAME=monkeyocr
MONKEYOCR_PROFILE=standard
# Set each production service to its own immutable GHCR digest.
MONKEYOCR_API_IMAGE=
MONKEYOCR_VLLM_IMAGE=
MONKEYOCR_WEB_IMAGE=
# Deprecated compatibility fallback used only when both service images are empty.
MONKEYOCR_IMAGE=
MONKEYOCR_UID=1000
MONKEYOCR_GID=1000
# Keep 127.0.0.1 for local use. In production, use the OCR host's exact private IP.
MONKEYOCR_API_BIND_ADDRESS=127.0.0.1
MONKEYOCR_API_HOST_PORT=8000
# Keep local-only for development. In production, bind to the OCR host's private IP.
MONKEYOCR_WEB_BIND_ADDRESS=127.0.0.1
MONKEYOCR_WEB_HOST_PORT=8080
MONKEYOCR_MODEL_ROOT=./model_weight
MONKEYOCR_RESULTS_ROOT=./output/api
MONKEYOCR_WEB_RESULTS_ROOT=./output/web
MONKEYOCR_TOKEN_SECRET_FILE=./dotenv/secrets/monkeyocr_api_token
