MONKEYOCR_PUBLIC_IP=203.0.113.10
MONKEYOCR_ACME_EMAIL=admin@example.com
MONKEYOCR_ACME_WEBROOT=/var/www/monkeyocr-acme
MONKEYOCR_ACME_STAGING=false
MONKEYOCR_NGINX_UPSTREAM=127.0.0.1:8000
# managed owns ports 80/443; preserve keeps the existing port-80 default server.
MONKEYOCR_HTTP_MODE=managed
# Used only in managed mode when Debian's default-site symlink exists.
MONKEYOCR_REPLACE_DEFAULT_SERVER=true
