MONKEYOCR_WEB_HOST=0.0.0.0
MONKEYOCR_WEB_PORT=8080
MONKEYOCR_WEB_OCR_BASE_URL=http://api:8000
MONKEYOCR_WEB_TOKEN_FILE=/run/secrets/monkeyocr_api_token
MONKEYOCR_WEB_RESULT_DIR=/var/lib/monkeyocr-web/jobs
MONKEYOCR_WEB_STATIC_DIR=/app/frontend/dist
MONKEYOCR_WEB_MAX_UPLOAD_BYTES=52428800
MONKEYOCR_WEB_MAX_PDF_PAGES=50
MONKEYOCR_WEB_QUEUE_SIZE=20
# Keep one worker unless the API and GPU have deliberately been sized for more concurrency.
MONKEYOCR_WEB_WORKERS=1
MONKEYOCR_WEB_RESULT_TTL_SECONDS=21600
MONKEYOCR_WEB_CLEANUP_INTERVAL_SECONDS=900
MONKEYOCR_WEB_UPSTREAM_TIMEOUT_SECONDS=3600
MONKEYOCR_WEB_MAX_EXTRACTED_BYTES=1073741824
MONKEYOCR_WEB_MAX_ARCHIVE_FILES=10000
MONKEYOCR_WEB_COOKIE_NAME=monkeyocr_ui_session
MONKEYOCR_WEB_COOKIE_PATH=/ocr-ui
MONKEYOCR_WEB_COOKIE_SECURE=true
MONKEYOCR_WEB_DEBUG=false
