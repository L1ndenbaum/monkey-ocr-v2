MONKEYOCR_MODEL_PATH=/models/MonkeyOCRv2-B-Parsing
MONKEYOCR_SERVER_URL=http://vllm:8888
MONKEYOCR_SERVED_MODEL_NAME=MonkeyOCRv2
MONKEYOCR_OUTPUT_DIR=/var/lib/monkeyocr/results
MONKEYOCR_TOKEN_FILE=/run/secrets/monkeyocr_api_token
MONKEYOCR_API_HOST=0.0.0.0
MONKEYOCR_API_PORT=8000
MONKEYOCR_MAX_UPLOAD_BYTES=52428800
MONKEYOCR_MAX_PDF_PAGES=50
MONKEYOCR_MAX_CONCURRENCY=4
MONKEYOCR_PAGE_MAX_INFLIGHT=4
MONKEYOCR_SERVER_MAX_INFLIGHT=4
MONKEYOCR_RESULT_TTL_SECONDS=21600
MONKEYOCR_CLEANUP_INTERVAL_SECONDS=900
MONKEYOCR_REQUEST_TIMEOUT_SECONDS=300
MONKEYOCR_HTTP_MAX_RETRIES=5
MONKEYOCR_HTTP_RETRY_BACKOFF=1.0
MONKEYOCR_PREPROCESS_BATCH_SIZE=32
MONKEYOCR_PREPROCESS_WAIT_SECONDS=1.0
MONKEYOCR_MAX_PIXELS=1003520
MONKEYOCR_TENSOR_PARALLEL_SIZE=1
MONKEYOCR_SKIP_PREPROCESS=false
MONKEYOCR_END2END=false
MONKEYOCR_RETRY_REPEAT=false
MONKEYOCR_KEEP_HEADER_FOOTER=false
MONKEYOCR_USE_BASE64=false
MONKEYOCR_DEBUG=false
MONKEYOCR_DOCS_ENABLED=false
