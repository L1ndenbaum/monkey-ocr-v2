limit_req_zone $binary_remote_addr zone=monkeyocr_rate:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=monkeyocr_connections:10m;

upstream monkeyocr_api {
    server ${MONKEYOCR_NGINX_UPSTREAM};
    keepalive 16;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${MONKEYOCR_PUBLIC_IP}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MONKEYOCR_PUBLIC_IP}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MonkeyOCRTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 50m;
    client_body_timeout 60s;
    limit_req_status 429;
    limit_conn_status 429;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location ^~ /api/v1/ {
        limit_req zone=monkeyocr_rate burst=4 nodelay;
        limit_conn monkeyocr_connections 4;

        proxy_pass http://monkeyocr_api;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        return 404;
    }
}
