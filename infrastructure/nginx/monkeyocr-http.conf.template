limit_req_zone $binary_remote_addr zone=monkeyocr_rate:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=monkeyocr_connections:10m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root ${MONKEYOCR_ACME_WEBROOT};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 503;
    }
}
